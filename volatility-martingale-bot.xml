<xml xmlns="http://w3.org" collection="false">
  <block type="trade" id="trade_setup" x="0" y="0">
    <statement name="SUBMARKET">
      <block type="variables_set" id="init_stake">
        <field name="VAR">Initial Stake</field>
        <value name="VALUE">
          <block type="math_number"><field name="NUM">1</field></block>
        </value>
        <next>
          <block type="variables_set" id="init_target">
            <field name="VAR">Target Profit</field>
            <value name="VALUE">
              <block type="math_number"><field name="NUM">10</field></block>
            </value>
            <next>
              <block type="variables_set" id="init_stop">
                <field name="VAR">Stop Loss</field>
                <value name="VALUE">
                  <block type="math_number"><field name="NUM">50</field></block>
                </value>
                <next>
                  <block type="variables_set" id="current_stake_set">
                    <field name="VAR">Current Stake</field>
                    <value name="VALUE">
                      <block type="variables_get"><field name="VAR">Initial Stake</field></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="strategy_setup" x="0" y="250">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="buy_rise">
        <field name="PURCHASE_LIST">RISE</field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="martingale_logic" x="0" y="400">
    <statement name="AFTERPURCHASE_STACK">
      <controls_if id="check_win">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result"><field name="CHECK_RESULT">win</field></block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="reset_stake">
            <field name="VAR">Current Stake</field>
            <value name="VALUE">
              <block type="variables_get"><field name="VAR">Initial Stake</field></block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="multiply_stake">
            <field name="VAR">Current Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">MULTIPLY</field>
                <value name="A"><block type="variables_get"><field name="VAR">Current Stake</field></block></value>
                <value name="B"><block type="math_number"><field name="NUM">2</field></block></value>
              </block>
            </value>
          </block>
        </statement>
      </controls_if>
    </statement>
  </block>
</xml>
